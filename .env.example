# Lead Platform — example environment file.
# Copy to .env (gitignored) and fill in values.

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# ---- Database ----
# Used by Next.js app at runtime and by Drizzle CLI for migrations.
DATABASE_URL=postgres://lead:lead@localhost:5432/lead

# ---- Auth (Auth.js / next-auth) ----
# AUTH_SECRET: generate with `openssl rand -hex 32`. Required.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — create at https://console.cloud.google.com/
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner bootstrap: first user with this email becomes super_admin on first login.
OWNER_EMAIL=

# ---- Master encryption key ----
# Used to encrypt workspace_secrets at rest (AES-256-GCM). Generate once
# with `openssl rand -hex 32`. NEVER rotate without re-encrypting all
# secrets — see docs/DEPLOYMENT.md.
MASTER_KEY=

# ---- Storage (file storage abstraction) ----
# Phase 1: local filesystem implementation. Phase 9+: S3-compatible.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage

# When STORAGE_PROVIDER=s3 (later):
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Job queue ----
# `memory` runs handlers on the next microtask in-process (fine for dev,
# loses jobs on restart). `bullmq` requires Redis; jobs are durable and
# can be processed by any number of worker processes.
JOB_QUEUE_PROVIDER=memory
# JOB_QUEUE_PROVIDER=bullmq
REDIS_URL=redis://localhost:6379

# ---- Providers ----
# Per-capability resolution: workspace setting → env selector below →
# auto-detected system default (first vendor whose platform key is set;
# see systemDefaultProvider in src/lib/services/provider-settings.ts).
# With the keys filled in you normally DON'T need the *_PROVIDER
# selectors at all — every workspace runs on real providers out of the
# box. 'mock' is a dev/test tool; in production a missing key fails
# loudly instead of silently falling back to mock data.

# Selectors (all optional):
# AI_PROVIDER=gemini | openai | anthropic | mock
# AI_MODEL=
# EMBEDDING_PROVIDER=openai | mock
# EMBEDDING_MODEL=
# RESEARCH_PROVIDER=gemini | perplexity | mock
# RESEARCH_MODEL=
# SEARCH_PROVIDER=serpapi | mock
# VECTOR_STORAGE_PROVIDER=pgvector | openai | mock   (system default: pgvector)

# Platform (system) API keys. Workspaces without their own BYOK secret
# fall back to these; usage on these keys is billed in tokens.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# SerpAPI is optional — without it, web search runs on grounded Gemini.
SERPAPI_KEY=

# ---- Telemetry / cost tracking ----
USAGE_LOG_ENABLED=true
