# Lead Platform — example environment file.
# Copy to .env (gitignored) and fill in values.

# ---- App ----
NODE_ENV=development
# The public URL: links in emails, and the origin of the og:image link preview
# (src/lib/app-origin.ts; falls back to AUTH_URL).
APP_URL=http://localhost:3000
PORT=3000

# ---- Database ----
# Used by Next.js app at runtime and by Drizzle CLI for migrations.
DATABASE_URL=postgres://lead:lead@localhost:5432/lead

# ---- Auth (Auth.js / next-auth) ----
# AUTH_SECRET: generate with `openssl rand -hex 32`. Required.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth — create at https://console.cloud.google.com/
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Owner bootstrap: first user with this email becomes super_admin on first login.
OWNER_EMAIL=

# ---- Master encryption key ----
# Used to encrypt workspace_secrets at rest (AES-256-GCM). Generate once
# with `openssl rand -hex 32`. NEVER rotate without re-encrypting all
# secrets — see docs/DEPLOYMENT.md.
MASTER_KEY=

# ---- Storage (file storage abstraction) ----
# Phase 1: local filesystem implementation. Phase 9+: S3-compatible.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage

# When STORAGE_PROVIDER=s3 (later):
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---- Job queue ----
# `memory` runs handlers on the next microtask in-process (fine for dev,
# loses jobs on restart). `bullmq` requires Redis; jobs are durable and
# can be processed by any number of worker processes.
JOB_QUEUE_PROVIDER=memory
# JOB_QUEUE_PROVIDER=bullmq
REDIS_URL=redis://localhost:6379
# PC-36: what this process does. `all` (the default) serves HTTP and runs
# the background jobs; `web` serves HTTP and only enqueues (needs bullmq);
# `worker` is for the worker entry (`pnpm worker`), which runs the jobs and
# serves no HTTP. Production sets it per service in docker-compose.prod.yml.
# ROLE=all
# Jobs one worker runs at once per lane: ticks (drain, inbox sync, probes,
# sweepers, reaper; default 4), batch (the long AI ticks: autopilot,
# follow-ups, health check, compaction; default 3) and runs (discovery
# runs, knowledge indexing, learning, Re-classify all; default 2).
# Integers 1-32.
# JOB_TICKS_CONCURRENCY=4
# JOB_BATCH_CONCURRENCY=3
# JOB_RUNS_CONCURRENCY=2

# ---- Operations monitoring (PC-07, docs/OPS_MONITORING.md) ----
# Unlocks the full /api/ready report (`Authorization: Bearer <token>`).
# At least 16 characters (openssl rand -hex 24); unset = detail hidden.
# OPS_READY_TOKEN=
# Commit of the running build, shown in that report. Docker builds set it
# from the BUILD_SHA build argument; leave unset locally.
# BUILD_SHA=

# ---- Owner alerts (PC-08, docs/OPS_MONITORING.md#owner-alerts-ntfy) ----
# ntfy topic that incidents, stale ticks, platform stop/hold changes and the
# daily digest are pushed to. Unset = alerts off (logged once at startup).
# On ntfy.sh the topic name is the password: make it long and random
# (leadsonar-$(openssl rand -hex 12)) or reserve it and set NTFY_TOKEN.
# NTFY_TOPIC=
# ntfy server base URL (default https://ntfy.sh). No credentials in it.
# NTFY_URL=https://ntfy.sh
# Access token (tk_...) for a reserved / access-controlled topic.
# NTFY_TOKEN=
# Lowest incident severity that alerts: warning | error (default) | critical.
# OPS_ALERT_MIN_SEVERITY=error

# ---- Providers ----
# Per-capability resolution: workspace setting → env selector below →
# auto-detected system default (first vendor whose platform key is set;
# see systemDefaultProvider in src/lib/services/provider-settings.ts).
# With the keys filled in you normally DON'T need the *_PROVIDER
# selectors at all — every workspace runs on real providers out of the
# box. 'mock' is a dev/test tool; in production a missing key fails
# loudly instead of silently falling back to mock data.

# Selectors (all optional):
# AI_PROVIDER=gemini | openai | anthropic | mock
# AI_MODEL=
# EMBEDDING_PROVIDER=openai | mock
# EMBEDDING_MODEL=
# RESEARCH_PROVIDER=gemini | perplexity | mock
# RESEARCH_MODEL=
# SEARCH_PROVIDER=serpapi | mock
# VECTOR_STORAGE_PROVIDER=pgvector | openai | mock   (system default: pgvector)

# Platform (system) API keys. Workspaces without their own BYOK secret
# fall back to these; usage on these keys is billed in tokens.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
# SerpAPI is optional — without it, web search runs on grounded Gemini.
SERPAPI_KEY=

# ---- Telemetry / cost tracking ----
USAGE_LOG_ENABLED=true

# ---- Test-only routes ----
# 1 enables probes such as /test-only/error-boundary (throws on purpose so
# smoke tests can check the branded error page). Leave unset in production.
# ENABLE_TEST_ROUTES=1
